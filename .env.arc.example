###############################################################################
### Copy this file to `.env.arc`. Then write the real values. Git must      ###
### never hold `.env.arc`.                                                  ###
###############################################################################
#
# The Arc testnet profile. `TEECASH_ENV=arc just <task>` reads it.
#
# An Arc run spends testnet USDC. One full run costs about 0.09 USDC of gas. Do
# `just sweep` at the end of each run. It returns the deposits to the deployer.

# The Arc testnet node.
TEECASH_RPC=https://rpc.testnet.arc.io

# Only the CRE forwarder can deliver a report. A simulation writes through the mock
# forwarder of the chain. `cre workflow supported-chains` prints both addresses.
TEECASH_CRE_FORWARDER=0x6E9EE680ef59ef64Aa8C7371279c27E496b5eDc1

# The CRE settings block that `workflow/project.yaml` holds. `production-settings`
# names Arc. `staging-settings` names a local anvil.
CRE_TARGET=production-settings

# The relayer. `just relay` sends each claim to this address. The service then pays
# the gas of that claim.
TEECASH_RELAYER=http://127.0.0.1:8787
RELAYER_LISTEN=127.0.0.1:8787

# The browser origins that may call the relayer. An empty list permits no origin.
RELAYER_ORIGINS=http://localhost:3000

# The account that receives the mint tax. The deployer takes the role when this
# variable is absent.
#TEECASH_TREASURY=
