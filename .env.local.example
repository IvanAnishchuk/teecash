###############################################################################
### Copy this file to `.env.local`. Git must never hold `.env.local`.       ###
###############################################################################
#
# The local profile. It is the default. Plain `just <task>` reads it.
#
# Start the chain with `just anvil` first. The chain ID must be 5042002. The contract
# builds its domain tag from `block.chainid`, so another chain ID gives another tag.

# The local node.
TEECASH_RPC=http://127.0.0.1:8545

# The deployer takes the role of the forwarder here. `just mint` then announces from
# that account. No CRE simulation is necessary. Set the mock forwarder of the chain
# when you want the CRE path instead.
#TEECASH_CRE_FORWARDER=0x6E9EE680ef59ef64Aa8C7371279c27E496b5eDc1

# The CRE settings block that `workflow/project.yaml` holds. `staging-settings` names
# a local anvil.
CRE_TARGET=staging-settings

# The relayer.
TEECASH_RELAYER=http://127.0.0.1:8787
RELAYER_LISTEN=127.0.0.1:8787
RELAYER_ORIGINS=http://localhost:3000

# A local anvil needs no priority fee. The suggestion of the node carries one.
TEECASH_PRIORITY_FEE=0
