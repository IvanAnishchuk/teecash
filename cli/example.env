# Copy to cli/.env and fill in. The .env file stays out of git.

# Privy. The app ID is public. The app secret is not.
# dashboard.privy.io -> Settings -> API keys
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Wallet provider: local or privy.
TEECASH_WALLETS=local

# Chain. The default node is a local anvil.
TEECASH_RPC=http://127.0.0.1:8545
