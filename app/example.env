# Copy to .env.local. That file stays outside git.
# No value here is a secret. The bundle carries every one of them.

# The Privy application. The app secret belongs to the CLI and never to this app.
NEXT_PUBLIC_PRIVY_APP_ID=

# The chain. The domain tag of the contract covers the identifier, so it must be exact.
NEXT_PUBLIC_TEECASH_CHAIN_ID=5042002
NEXT_PUBLIC_TEECASH_RPC=http://127.0.0.1:8545

# The BlindMint deployment. `.tmp/cli-state.json` holds the current address.
NEXT_PUBLIC_TEECASH_CONTRACT=

# The claim relayer. It is the Go service in `workflow/relayer`.
NEXT_PUBLIC_TEECASH_RELAYER=http://127.0.0.1:8787
